{
  "name": "context_master",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run clean:cache && next dev",
    "dev:fresh": "npm run clean && next dev",
    "build": "next build",
    "build:fresh": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next tsconfig.tsbuildinfo && npm cache clean --force",
    "clean:cache": "rm -rf .next/cache tsconfig.tsbuildinfo",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:health": "tsx scripts/db-health-check.ts",
    "db:seed:reset": "prisma migrate reset --skip-seed && prisma db seed",
    "db:seed:dev": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
